# Environment variables for the RAG Pipeline
# Copy this file to .env and fill in your actual values

# Google Cloud credentials
GOOGLE_API_KEY=your_google_api_key_here
PROJECT_ID=your_gcp_project_id
REGION=your_gcp_region

# Embedding Configuration
EMBEDDING_PROVIDER=vertexai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024

# Security Configuration

# Authentication Provider - Choose between "local" or "supabase"
AUTH_PROVIDER=local

# JWT Authentication - REQUIRED for production (when using local auth)
# Generate a secure secret key using: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-very-secure-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Authentication - REQUIRED when AUTH_PROVIDER=supabase
# Get these from your Supabase project settings (https://app.supabase.com)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# API Keys (Legacy - for backward compatibility)
# Generate secure keys using: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Provide comma-separated list of valid API keys
SERVICE_API_KEYS=your-secret-api-key-here

# CORS Allowed Origins
# Comma-separated list of allowed origins for cross-origin requests
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# API Key Header Name (optional, default: X-API-Key)
API_KEY_HEADER=X-API-Key

# File Upload Limits
# Maximum file size in megabytes
UPLOAD_MAX_MEGABYTES=50

# Security Feature Flags
# Set to false only for local development - ALWAYS keep true in production!
ENABLE_CORS=true
ENABLE_JWT_AUTH=true
ENABLE_API_KEY_AUTH=false
ENABLE_FILE_VALIDATION=true

# Optional: Redis Configuration for Token Blacklist (logout functionality)
# Only needed when AUTH_PROVIDER=supabase and you want immediate token revocation
ENABLE_TOKEN_BLACKLIST=false
REDIS_URL=redis://localhost:6379/0

# LangSmith (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
